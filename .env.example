# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/assistant

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Open-source / OpenAI-compatible (self-hosted or 3rd-party)
OPEN_SOURCE_API_KEY=
OPEN_SOURCE_BASE_URL=
OPEN_SOURCE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# OpenRouter (single key for many OpenAI / Anthropic / open models)
# OpenAI-compatible gateway: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# LLM defaults
DEFAULT_PROVIDER=openrouter
FALLBACK_PROVIDER=
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT=60
MAX_CONTEXT_TOKENS=12000
SUMMARY_THRESHOLD=30

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE=0.5
RETRY_BACKOFF_MAX=8

# Logging
LOG_LEVEL=INFO

# Security
MAX_REQUEST_LENGTH=32000
