# Local environment - DO NOT COMMIT (gitignored)
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/assistant

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# --- Single key via OpenRouter (OpenAI-compatible gateway) ---
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# LLM defaults
DEFAULT_PROVIDER=openrouter
FALLBACK_PROVIDER=
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT=60
MAX_CONTEXT_TOKENS=12000
SUMMARY_THRESHOLD=30

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE=0.5
RETRY_BACKOFF_MAX=8

# Logging
LOG_LEVEL=INFO

# Security
MAX_REQUEST_LENGTH=32000
